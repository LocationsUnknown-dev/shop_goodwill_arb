ANTHROPIC_API_KEY=sk-ant-...

# Shop Goodwill category id for "Gaming Systems".
# If listings look wrong: open https://shopgoodwill.com/categories/gaming-systems
# in Chrome, open DevTools > Network, filter on "ItemListing", and copy the
# "catIds" value from the request body.
SHOPGOODWILL_CAT_IDS=26

# Flat shipping + handling assumption, in dollars.
SHIPPING_COST=20

# Server port.
PORT=5000
